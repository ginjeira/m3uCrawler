  "implementation_rules": [
    "Do not infer canonical identity from source channel number.",
    "Do not use source group-title as canonical group without normalization.",
    "If multiple variants of the same channel exist, prefer HD/FHD according to dashboard policy.",
    "Do not delete an unmatched channel solely because it is not in the catalog; classify it as Unmatched/Other for review.",
    "Canonical numbering must be deterministic.",
    "VOD must never consume linear-TV canonical positions.",
    "Every configurable behavior must be exposed to the Dashboard."
  ]
